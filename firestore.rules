rules_version = '2';

// ============================================================
//  Reglas de seguridad de Firestore — Lista de tareas (PWA)
//  Cada usuario solo puede leer y modificar SUS PROPIAS tareas.
//  No hay ninguna regla abierta (nada de allow ...: if true).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Solo el dueño del documento (uid == auth.uid) puede leerlo o borrarlo.
    function isOwner() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // Valida la forma del documento y que el uid sea el del usuario autenticado.
    function validTask(data) {
      return data.keys().hasAll(['uid', 'title', 'completed', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.completed is bool
        && (!data.keys().hasAny(['notes'])
            || (data.notes is string && data.notes.size() <= 1000));
    }

    match /tasks/{taskId} {
      // Listar y leer: únicamente tareas propias.
      allow read: if isOwner();

      // Crear: la tarea debe nacer con el uid del usuario autenticado.
      allow create: if signedIn() && validTask(request.resource.data);

      // Editar: solo el dueño, sin cambiar el uid ni los campos de creación.
      allow update: if isOwner()
        && request.resource.data.uid == resource.data.uid
        && validTask(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'notes', 'completed', 'updatedAt']);

      // Eliminar: únicamente tareas propias.
      allow delete: if isOwner();
    }

    // Cualquier otra colección o documento queda totalmente bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
